{
  "description": "Test JSON for ChildAuthController changePassword function",
  "endpoint": "POST /api/children/change-password",
  "authentication_required": true,
  "middleware": ["auth:sanctum", "role:child"],
  "headers": {
    "Content-Type": "application/json",
    "Authorization": "Bearer YOUR_CHILD_TOKEN_HERE",
    "Accept": "application/json"
  },
  
  "test_cases": [
    {
      "name": "Valid password change",
      "payload": {
        "current_password": "oldpassword123",
        "new_password": "newpassword123",
        "new_password_confirmation": "newpassword123"
      },
      "expected_response": {
        "status": 200,
        "message": "Password changed successfully"
      }
    },
    {
      "name": "Invalid current password",
      "payload": {
        "current_password": "wrongpassword",
        "new_password": "newpassword123",
        "new_password_confirmation": "newpassword123"
      },
      "expected_response": {
        "status": 403,
        "message": "Current password is incorrect"
      }
    },
    {
      "name": "New password too short",
      "payload": {
        "current_password": "oldpassword123",
        "new_password": "short",
        "new_password_confirmation": "short"
      },
      "expected_response": {
        "status": 422,
        "message": "Validation failed",
        "errors": {
          "new_password": ["The new password must be at least 8 characters."]
        }
      }
    },
    {
      "name": "New password confirmation mismatch",
      "payload": {
        "current_password": "oldpassword123",
        "new_password": "newpassword123",
        "new_password_confirmation": "differentpassword123"
      },
      "expected_response": {
        "status": 422,
        "message": "Validation failed",
        "errors": {
          "new_password": ["The new password confirmation does not match."]
        }
      }
    },
    {
      "name": "Missing current password",
      "payload": {
        "new_password": "newpassword123",
        "new_password_confirmation": "newpassword123"
      },
      "expected_response": {
        "status": 422,
        "message": "Validation failed",
        "errors": {
          "current_password": ["The current password field is required."]
        }
      }
    },
    {
      "name": "Missing new password",
      "payload": {
        "current_password": "oldpassword123",
        "new_password_confirmation": "newpassword123"
      },
      "expected_response": {
        "status": 422,
        "message": "Validation failed",
        "errors": {
          "new_password": ["The new password field is required."]
        }
      }
    },
    {
      "name": "Missing new password confirmation",
      "payload": {
        "current_password": "oldpassword123",
        "new_password": "newpassword123"
      },
      "expected_response": {
        "status": 422,
        "message": "Validation failed",
        "errors": {
          "new_password": ["The new password confirmation does not match."]
        }
      }
    }
  ],
  
  "authentication_steps": [
    {
      "step": 1,
      "description": "Login as a child user first",
      "endpoint": "POST /api/childLogin",
      "payload": {
        "username": "child_username",
        "password": "current_password",
        "device_name": "Test Device"
      }
    },
    {
      "step": 2,
      "description": "Copy the 'access_token' from login response"
    },
    {
      "step": 3,
      "description": "Add Authorization header with Bearer token to change-password request"
    }
  ],
  
  "validation_rules": {
    "current_password": "required",
    "new_password": "required|min:8|confirmed",
    "new_password_confirmation": "required (implied by confirmed rule)"
  },
  
  "function_logic": [
    "1. Validates request parameters",
    "2. Gets authenticated user from request",
    "3. Verifies current password matches user's password",
    "4. Updates user password with new hashed password",
    "5. Uses database transaction for safety",
    "6. Returns success or error response"
  ],
  
  "quick_test_example": {
    "description": "Ready-to-use test payload",
    "endpoint": "POST /api/children/change-password",
    "headers": {
      "Authorization": "Bearer YOUR_TOKEN_HERE",
      "Content-Type": "application/json"
    },
    "payload": {
      "current_password": "oldpassword123",
      "new_password": "newpassword123",
      "new_password_confirmation": "newpassword123"
    }
  },
  
  "common_errors": [
    {
      "error": "401 Unauthorized",
      "cause": "Missing or invalid authentication token",
      "solution": "Login first and use the Bearer token"
    },
    {
      "error": "403 Forbidden",
      "cause": "User doesn't have 'child' role or wrong current password",
      "solution": "Ensure user has child role and correct current password"
    },
    {
      "error": "422 Validation Error",
      "cause": "Invalid input data (short password, mismatch, missing fields)",
      "solution": "Check validation rules and fix input data"
    }
  ],
  
  "postman_setup": [
    "1. Set base URL: {{base_url}} = http://your-domain.com",
    "2. Login as child user to get token",
    "3. Set environment variable: {{child_token}}",
    "4. Use Authorization: Bearer {{child_token}}",
    "5. Set Content-Type: application/json"
  ]
}
